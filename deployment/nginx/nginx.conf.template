
ssl_session_cache   shared:SSL:10m;
ssl_session_timeout 10m;

resolver 127.0.0.11 valid=30s;

server {
    listen 443 ssl http2;
    server_name         dozzle.${DOMAIN_NAME};
    access_log  off;
    http2  on;
    ssl_certificate     /etc/nginx/ssl/${DOMAIN_NAME}/fullchain.pem;
    ssl_certificate_key /etc/nginx/ssl/${DOMAIN_NAME}/key.pem;
    allow 10.8.0.0/24;
    deny all;

    location / {
        set $upstream dozzle;
        proxy_pass http://$upstream:8080;
    }
  }

server {
  listen 443 ssl http2;
  server_name         admin.${DOMAIN_NAME};
  access_log  off;
  ssl_certificate     /etc/nginx/ssl/${DOMAIN_NAME}/fullchain.pem;
  ssl_certificate_key /etc/nginx/ssl/${DOMAIN_NAME}/key.pem;
