server {
  listen 443 ssl http2;
  server_name         ${DOMAIN_NAME} www.${DOMAIN_NAME};
  ssl_certificate     /etc/nginx/ssl/${DOMAIN_NAME}/fullchain.pem;
  ssl_certificate_key /etc/nginx/ssl/${DOMAIN_NAME}/key.pem;

  location = /.well-known/apple-app-site-association {
     default_type application/json;
     alias /srv/static/ios_well_known.json;
  }
  location = /.well-known/assetlinks.json {
     default_type application/json;
     alias /srv/static/android_well_known.json;
  }
  location /api/auth {
      set $upstream authorization.service;
      proxy_pass https://$upstream;
      proxy_http_version 2;
  }
  location /api/user {
      set $upstream user.service;
      proxy_pass https://$upstream;
      proxy_http_version 2;
  }
  location /api/business {
      set $upstream business.service;
      proxy_pass https://$upstream;
      proxy_http_version 2;
  }
}